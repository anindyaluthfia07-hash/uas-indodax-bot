# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
# Untuk forward test di laptop, cukup jalankan tanpa .env (storage lokal).

# Wajib di Vercel: Redis REST dari Vercel Marketplace (Upstash).
# Vercel tidak punya filesystem permanen; tanpa dua variabel ini endpoint
# akan menolak berjalan (fail loud), bukan menyimpan state ke /tmp.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Wajib di Vercel dan GitHub Actions. String acak panjang.
# Dipakai sebagai Authorization: Bearer <CRON_SECRET> pada /api/tick,
# /api/kill, dan /api/export.
CRON_SECRET=

# Opsional: set "1"/"true" untuk memblokir entry baru tanpa mengubah Redis.
KILL_SWITCH=0

# Opsional untuk pengembangan lokal: folder penyimpanan state/log.
# Default: data/local
LOCAL_STORAGE_DIR=
